# Copy to .env next to where you start the agent. .env is never committed.

# Where the agent keeps its keys, paired phones and uploads (default: ~/.remote-sheep)
REMOTE_SHEEP_HOME=

# Your relay, to reach the phone outside the LAN, and the access code its owner gave you
REMOTE_SHEEP_RELAY=
REMOTE_SHEEP_RELAY_CODE=

# 1 lists plain shell panes (consoles) as well as coding agents
REMOTE_SHEEP_SHELLS=0
